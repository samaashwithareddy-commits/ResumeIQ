# ---------------------------------------------------------------------------
# ResumeIQ configuration
# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# Secret key used by Flask for sessions/flash messages.
# Any long random string works. Example generator:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-long-random-string

# Featherless AI (optional). Without a key the app runs in clearly labelled
# demo mode: deterministic matching + heuristic suggestions, no AI calls.
# Get a key at https://featherless.ai  (OpenAI-compatible API).
FEATHERLESS_API_KEY=rc_b1262c22a443863d7f009793555f06c196bd84b44053fbd217cc168854d1c3a5

# OpenAI-compatible base URL and a chat model available on your Featherless plan.
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct

# SQLite file (relative paths are resolved from the project root).
RESUMEIQ_DB=database/resumeiq.db

# Host/port used by "python app.py".
HOST=127.0.0.1
PORT=5000

# Set to 1 to enable Flask debug mode locally. Leave 0 for demos.
FLASK_DEBUG=0
